# God's Eye Backend Environment Configuration
# Copy to .env and fill in values

# App
APP_NAME=godseye
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Storage
DATA_DIR=../data

# Upload limits
MAX_UPLOAD_SIZE_MB=5120

# CORS
FRONTEND_URL=http://localhost:5173

# Modal (future)
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
